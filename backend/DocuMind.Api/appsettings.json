{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "DocuMind.Api",
    "Audience": "DocuMind.Spa",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Storage": {
    "Provider": "Cloudinary",
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".pdf"
    ],
    "Local": {
      "UploadDirectory": "uploads"
    },
    "Cloudinary": {
      "CloudName": "",
      "ApiKey": "",
      "ApiSecret": "",
      "Folder": "documind",
      "TicketLifetimeSeconds": 600
    }
  },
  "Rag": {
    "ChunkSize": 1000,
    "ChunkOverlap": 150,
    "TopK": 5,
    "SimilarityThreshold": 0.25,
    "MaxContextChunks": 5,
    "MaxHistoryMessages": 8
  },
  "AI": {
    "Provider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "ChatModel": "gpt-4o-mini",
    "Endpoint": ""
  }
}
